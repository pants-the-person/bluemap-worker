{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bluemap-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "ENABLE_LIVE_DATA": "false"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  },
  "routes": [
    {
      "pattern": "map.pants.place",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": false
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "6904a6e6a1bb43b2a107f2d5fd19670e"
    }
  ]
}
